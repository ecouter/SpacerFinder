// Design tokens for the SpacerFinder "instrument panel" look.
export global Theme {
    in-out property <color> bg: #0b1220;
    in-out property <color> surface: #131d2b;
    in-out property <color> surface-raised: #1b2838;
    in-out property <color> surface-hover: #24354a;
    in-out property <color> border: #2d3f55;
    in-out property <color> border-strong: #3d5675;
    in-out property <color> text: #e6edf3;
    in-out property <color> text-muted: #8fa3bb;
    in-out property <color> accent: #2dd4bf;
    in-out property <color> accent-hover: #5eead4;
    in-out property <color> accent-text: #062421;
    in-out property <color> danger: #f87171;
    in-out property <color> danger-hover: #ff9b9b;
    in-out property <color> warning: #fbbf24;
    in-out property <color> success: #4ade80;

    in-out property <length> space-xs: 4px;
    in-out property <length> space-sm: 8px;
    in-out property <length> space-md: 12px;
    in-out property <length> space-lg: 16px;
    in-out property <length> space-xl: 24px;
    in-out property <length> radius: 8px;

    // Shared table column widths (keep headers and rows in sync).
    in-out property <length> col-thread: 72px;
    in-out property <length> col-arrow: 20px;
    in-out property <length> col-length: 90px;
}
